{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '[user-local-time local: %s]\\n' \"$(TZ=<YOUR_IANA_TZ> date '+%Y-%m-%d %H:%M %Z (%A)' 2>/dev/null || echo unavailable)\""
          }
        ]
      }
    ]
  }
}
